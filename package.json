{
    "private": true,
    "license": "MIT",
    "version": "0.3.0",
    "name": "@sabre/monorepo",
    "workspaces": [
        "source/*"
    ],
    "scripts": {
        "--  WORKSPACE  --": "",
        "vscode": "cd source/vscode && bun run",
        "website": "cd source/website && bun run",
        "--  TOOLS  --": "",
        "tools:test": "./build/source/tests/tests",
        "tools:profile": "bun run ./tools/profile",
        "tools:version": "bun run ./tools/version",
        "--  CLEAN  --": "",
        "clean": "run-p clean:*",
        "clean:sabre": "rimraf dist",
        "clean:vscode": "bun vscode clean",
        "clean:website": "bun website clean"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "jsonc-parser": "^3.3.1",
        "npm-run-all2": "^9.0.3",
        "rimraf": "^6.1.3",
        "sharp": "^0.35.3",
        "type-fest": "^5.8.0",
        "typescript": "^6.0.3",
        "yaml": "^2.9.0"
    }
}
