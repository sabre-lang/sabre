///
/// @example "async.sabre"
/// @describe Showcases the design dimension of async/await in Sabre.
///

//
// Async/Await Design: https://cel.cs.brown.edu/blog/design-space-async-await/
//
// Start of Life:
//   Eagerness: semi-eager      (spawns virtual thread isolate)
//   Suspension: static         (await points guaranteed to suspend)
//
// End of Life:
//   Extent: indefinite         (tasks may exist until end of the runtime)
//   Strength: strong           (the runtime holds a strong reference: Future)
//   Destruction: terminated    (detached tasks are cancelled on program exit)
//   Propagation: never         (any exceptions are attached to the task)
//
// Cancellation: none           (cannot manually cancel tasks from running)
//

let write_to_log = fn {
    Debug.println("A");
    Future.delay(2000).await();
    Debug.println("B");
};

let fire_and_forget = fn {
    write_to_log::async();
};

fire_and_forget();
Future.delay(1000).await();
Debug.println("C");

// The expected output is: AC
