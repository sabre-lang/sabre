///
/// @testing Crate "env" Functionality.
/// @describe Coordinates testing the builtin "class" crate.
///

// Sabre Modules
import "sabre:env" as Env;
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST MOCKS - //

Env.set("KEY_A", "A");
Env.set("KEY_B", "B");

// - TEST CASES - //

Test.case("Env.get 'String'", fn {
    Assert.equals(Env.get("KEY_A"), "A");
    Assert.equals(Env.get("KEY_B"), "B");
    Assert.truthy(Env.get("KEY_C").empty());
});

Test.case("Env.drop 'String'", fn {
    // prepare a key-value pair to assign
    let key = "KEY_E";
    let value = "value";

    // prepare the key to be available
    Assert.truthy(Env.set(key, value));
    Assert.equals(Env.get(key), value);

    // attempt deleting the value now
    Assert.truthy(Env.drop(key));
    Assert.falsey(Env.drop(key));
    Assert.truthy(Env.get(key).empty());
});

Test.case("Env.set 'String, String'", fn {
    // prepare a key-value pair to assign
    let key = "KEY_D";
    let value = "value";

    Assert.truthy(Env.set(key, value)); // 'True' for insertion
    Assert.falsey(Env.set(key, value)); // 'False' for assignment
    Assert.equals(Env.get(key), value); // Should be same value
});
