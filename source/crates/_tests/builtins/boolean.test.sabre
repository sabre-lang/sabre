///
/// @testing Builtin "Boolean" Functionality.
/// @describe Coordinates testing the builtin "Boolean".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST CASES - //

Test.suite("Traits", fn {
    Test.case("Literal 'True'", fn => Assert.truthy(True));
    Test.case("Literal 'False'", fn => Assert.falsey(False));

    Test.case("Operator '!True'", fn => Assert.falsey(!True));
    Test.case("Operator '!False'", fn => Assert.truthy(!False));

    Test.case("Equality '!True == False'", fn => Assert.equals(!True, False));
    Test.case("Equality '!False == True'", fn => Assert.equals(!False, True));
    Test.case("Equality 'True != False'", fn => Assert.differs(True, False));
});

Test.suite("Statics", fn {
    Test.case("Boolean.from 'Number'", fn {
        Assert.equals(Boolean.from(1), True);
        Assert.equals(Boolean.from(0), False);
    });

    Test.case("Boolean.from 'String'", fn {
        Assert.equals(Boolean.from(""), False);
        Assert.equals(Boolean.from("abc"), True);
    });

    Test.case("Boolean.from 'Symbol'", fn {
        Assert.equals(Boolean.from(Symbol.from("")), True);
        Assert.equals(Boolean.from(Symbol.from("abc")), True);
    });

    Test.case("Boolean.from 'List'", fn {
        Assert.equals(Boolean.from([]), True);
    });
    Test.case("Boolean.from 'Object'", fn {
        Assert.equals(Boolean.from({}), True);
    });

    Test.case("Boolean.parse 'True'", fn {
        Assert.equals(Boolean.parse("true"), True);
        Assert.equals(Boolean.parse("True"), True);
        Assert.panics(fn => Boolean.parse("true", True));
    });

    Test.case("Boolean.parse 'False'", fn {
        Assert.equals(Boolean.parse("false"), False);
        Assert.equals(Boolean.parse("False"), False);
        Assert.panics(fn => Boolean.parse("false", True));
    });
});

// - TEST BENCHES - //

Test.suite("Benchmarks", fn {
    Test.bench("Boolean.from", fn => Boolean.from(42));
    Test.bench("Boolean.parse", fn => Boolean.parse("True"));
});
