///
/// @testing Builtin "Iterator" Functionality.
/// @describe Coordinates testing the builtin "Iterator".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// Internal Modules
import "sabre:_detail" as Detail;

// - TEST CASES - //

Test.suite("Traits", fn {
    // construct a stateful iterator
    let iterator = Iterator.range(42);

    // test iterating over the available range
    Test.case("For '[...]'", fn {
        Assert.okay(iterator is Iterator[Number]);
        for (nn, ii in iterator) Assert.equals(nn, ii);
    });
});

Test.suite("Methods", fn {
    // construct a stateful iterator
    let iterator = Iterator.range(1);

    // test the incoming expected sequence now
    Test.case("Iterator.index '0'", fn => Assert.equals(iterator.index(), 0));
    Test.case("Iterator.done 'False'", fn => Assert.falsey(iterator.done()));
    Test.case("Iterator.next '()'", fn => Assert.equals(iterator.next(), False));
    Test.case("Iterator.next '()'", fn => Assert.equals(iterator.next(), True));
    Test.case("Iterator.done 'True'", fn => Assert.truthy(iterator.done()));

    // the ".collect" method takes a little extra testing
    Test.case("Iterator.collect '()'", fn {
        let size = 5; // prepare a size to use
        let range = Iterator.range(size);
        let list = range.collect();

        Assert.truthy(range.done());
        Assert.equals(list.size(), size);
    });
});

Test.suite("Statics", fn {
    // construct an empty iterator
    let empty = Iterator.empty();

    // construct an iterator from a string
    let message = "Hello, from an iterator";
    let sequence = Iterator.from(message);

    let maximum = 5; // construct a generator based iterator
    let generator = Iterator.dynamic[Any](fn (index: Number, yield): Boolean {
        Detail.Unsafe.cast[Function](yield)(index);
        return index >= maximum; // check condition
    });

    // test the empty iterator now
    Test.case("Iterator.empty '()'", fn {
        Assert.equals(empty.index(), 0);
        Assert.truthy(empty.done());
        Assert.truthy(empty.next());
        Assert.equals(empty.index(), 0);
    });

    // test the sequence iterator
    Test.case("Iterator.from 'String'", fn {
        for (ch, ii in sequence) Assert.equals(ch, message.at(ii));
        Assert.equals(sequence.index() - 1, message.size());
    });

    // test the generator based iterator
    Test.case("Iterator.dynamic 'Function'", fn {
        Assert.equals(generator.index(), 0);
        for (nn, ii in generator) Assert.equals(nn, ii);
        Assert.equals(generator.index() - 1, maximum);
    });
});
