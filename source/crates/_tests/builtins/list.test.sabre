///
/// @testing Builtin "List" Functionality.
/// @describe Coordinates testing the builtin "List".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST MOCKS - //

namespace Mock {
    //! @brief Prepare an empty list.
    export let none = List.empty();

    //! @brief Prepare a ranged list.
    export let some = List.range(42);
};

// - TEST CASES - //

Test.suite("Traits", fn {
    Test.case("Empty '[]'", fn {
        Assert.truthy([].empty());
        Assert.equals([].size(), 0);
    });

    Test.case("For '[...]'", fn {
        for (nn, ii in Mock.some) Assert.equals(nn, ii);
    });
});

Test.suite("Methods", fn {
    Test.case("List.empty '()'", fn {
        Assert.truthy(Mock.none.empty());
        Assert.falsey(Mock.some.empty());
    });

    Test.case("List.size '()'", fn {
        Assert.equals(Mock.none.size(), 0);
        Assert.differs(Mock.some.size(), 0);
    });

    Test.case("List.back '()'", fn {
        Assert.panics(fn => Mock.none.back());
        Assert.equals(Mock.some.back(), 41);
    });

    Test.case("List.front '()'", fn {
        Assert.panics(fn => Mock.none.front());
        Assert.equals(Mock.some.front(), 0);
    });

    Test.case("List.get 'Number'", fn {
        Assert.panics(fn => Mock.none.get(0));
        Assert.equals(Mock.some.get(0), 0);
        Assert.equals(Mock.some.get(3), 3);
        Assert.panics(fn => Mock.some.get(43));
    });

    Test.case("List.set 'Number, Any'", fn {
        let other = 20;
        let temp = List.range(5);

        Assert.equals(temp.set(0, other), other);
        Assert.equals(temp.get(0), other);
    });

    Test.case("List.map 'Function'", fn {
        let values = [10, 20, 30];
        let doubled = values.map(fn (nn) => nn * 2);
        for (nn, ii in values) Assert.equals(nn * 2, doubled.get(ii));
    });

    Test.case("List.filter 'Function'", fn {
        let values = [10, 20, 30, 40, 50];
        let any = fn (_: Any): Boolean => True;
        let clear = fn (_: Any): Boolean => False;
        let gt30 = fn (nn: Number): Boolean => nn > 30;
        let gt50 = fn (nn: Number): Boolean => nn > 50;

        Assert.equals(values.filter(gt30).size(), 2);
        Assert.truthy(values.filter(gt50).empty());
        Assert.truthy(values.filter(clear).empty());
        Assert.equals(values.filter().size(), values.size());
        Assert.equals(values.filter(any).size(), values.size());
    });

    Test.case("List.fold 'Any, Function'", fn {
        let values = [10, 20, 30];
        let sum = values.fold(0, fn (aa, nn) => aa + nn);
        Assert.equals(sum, 60); // should be same value
    });

    Test.case("List.reverse '()'", fn {
        let values = [10, 20, 30];
        let reversed = values.reverse();

        Assert.equals(values.get(0), reversed.get(2));
        Assert.equals(values.get(1), reversed.get(1));
        Assert.equals(values.get(2), reversed.get(0));
    });

    Test.case("List.slice '...Number'", fn {
        let values = [10, 20, 30, 40];
        let none = values.slice(0, 0);
        let slice = values.slice(1, 3);

        Assert.truthy(none.empty());
        Assert.equals(slice.size(), 2);
        Assert.equals(slice.front(), 20);
    });

    Test.case("List.clear '()", fn {
        Assert.truthy([10, 20, 30].clear().empty());
    });

    Test.case("List.drop 'Number'", fn {
        let values = [10, 20, 30, 40, 50];
        Assert.equals(values.drop(1), 20);
        Assert.equals(values.drop(2), 40);
        Assert.equals(values.size(), 3);
    });

    Test.case("List.erase 'Number, Number'", fn {
        let values = [10, 20, 30, 40, 50];

        // remove the value of "20"
        Assert.equals(values.erase(1, 2).size(), 4);
        Assert.equals(values.first_index_of(20), -1);

        // remove values "30" and "40"
        Assert.equals(values.erase(1, 3).size(), 2);
        Assert.equals(values.first_index_of(30), -1);
        Assert.equals(values.first_index_of(40), -1);

        // clear the set of values (typically range first -> last)
        Assert.truthy(values.erase(0, values.size()).empty());
    });

    Test.case("List.pop_back '...Any'", fn {
        let values = [10, 20]; // prepare
        Assert.equals(values.pop_back(), 20);
        Assert.equals(values.pop_back(), 10);
        Assert.panics(fn => values.pop_back());
    });

    Test.case("List.pop_front '...Any'", fn {
        let values = [10, 20]; // prepare
        Assert.equals(values.pop_front(), 10);
        Assert.equals(values.pop_front(), 20);
        Assert.panics(fn => values.pop_front());
    });

    Test.case("List.push_back '...Any'", fn {
        let values: List[Number] = [];
        values.push_back(10, 20, 30);

        Assert.equals(values.size(), 3);
        Assert.equals(values.get(0), 10);
        Assert.equals(values.get(1), 20);
        Assert.equals(values.get(2), 30);
    });

    Test.case("List.push_front '...Any'", fn {
        let values: List[Number] = [];

        // push our values seperately
        values.push_front(10);
        values.push_front(20);
        values.push_front(30);

        Assert.equals(values.size(), 3);
        Assert.equals(values.get(0), 30);
        Assert.equals(values.get(1), 20);
        Assert.equals(values.get(2), 10);
    });

    Test.case("List.last_index_of 'Any'", fn {
        Assert.equals([].last_index_of(10), -1);
        Assert.equals([10, 20, 30].last_index_of(20), 1);
        Assert.equals([10, 20, 10].last_index_of(10), 2);
        Assert.equals([10, 20, 30].last_index_of(40), -1);
    });

    Test.case("List.first_index_of 'Any'", fn {
        Assert.equals([].first_index_of(10), -1);
        Assert.equals([10, 20, 30].first_index_of(20), 1);
        Assert.equals([10, 20, 10].first_index_of(10), 0);
        Assert.equals([10, 20, 30].first_index_of(40), -1);
    });
});

Test.suite("Statics", fn {
    Test.case("List.from '...Any'", fn {
        let value = "A string value";
        let list = List.from(value);
        Assert.equals(list.size(), value.size());
        for (cc, ii in list) Assert.equals(cc, value.at(ii));
    });

    Test.case("List.empty '()'", fn {
        let list = List.empty();
        Assert.truthy(list.empty());
        Assert.equals(list.size(), 0);
    });

    Test.case("List.range '...Number'", fn {
        let size = 42; // base size
        let range = List.range(size);
        Assert.equals(range.size(), size);
        for (nn, ii in range) Assert.equals(nn, ii);
    });

    Test.case("List.filled, 'Number, Any", fn {
        let none = List.filled(0, Void);
        Assert.truthy(none.empty());

        let size = 5; // prepare size
        let filled = List.filled(size, Void);
        Assert.equals(filled.size(), size);
        for (vv in filled) Assert.equals(vv, Void);
    });
});
