///
/// @testing Builtin "Enum" Functionality.
/// @describe Coordinates testing the builtin "Enum".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST MOCKS - //

//! @brief A mocked enumeration value.
enum Mock {
    A("a"),
    B("b") = 10,
    C("c"),
    D("d") = 20,
    E("e"),
    F("f") = -1,
    G("g"),
};

// - TEST CASES - //

Test.suite("Traits", fn {
    Test.case("Variant 'Mock.A == 0'", fn => Assert.equals(Mock.A, 0));
    Test.case("Variant 'Mock.B == 10'", fn => Assert.equals(Mock.B, 10));
    Test.case("Variant 'Mock.C == 11'", fn => Assert.equals(Mock.C, 11));
    Test.case("Variant 'Mock.D == 20'", fn => Assert.equals(Mock.D, 20));
    Test.case("Variant 'Mock.E == 21'", fn => Assert.equals(Mock.E, 21));
    Test.case("Variant 'Mock.F == -1'", fn => Assert.equals(Mock.F, -1));
    Test.case("Variant 'Mock.G == 0'", fn => Assert.equals(Mock.G, 0));

    Test.case("Equality 'Mock.A == Mock.A'", fn => Assert.equals(Mock.A, Mock.A));
    Test.case("Equality 'Mock.A == Mock.G'", fn => Assert.equals(Mock.A, Mock.G));
    Test.case("Equality 'Mock.A != Mock.B'", fn => Assert.differs(Mock.A, Mock.B));
});

Test.suite("Statics", fn {
    Test.case("Enum.name 'A'", fn => Assert.equals(Enum.name(Mock, Mock.A), "A"));
    Test.case("Enum.name 'B'", fn => Assert.equals(Enum.name(Mock, Mock.B), "B"));

    Test.case("Enum.label 'A'", fn => Assert.equals(Enum.label(Mock, Mock.A), "a"));
    Test.case("Enum.label 'B'", fn => Assert.equals(Enum.label(Mock, Mock.B), "b"));

    Test.case("Enum.value 'A'", fn => Assert.equals(Mock.A, 0));
    Test.case("Enum.value 'B'", fn => Assert.equals(Mock.B, 10));
});
