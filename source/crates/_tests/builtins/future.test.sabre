///
/// @testing Builtin "Future" Functionality.
/// @describe Coordinates testing the builtin "Future".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// Internal Modules
import "sabre:_detail" as Detail;

// - TEST MOCKS - //

namespace Mock {
    //! @brief Prepare a suitable no-operation function.
    export let noop = fn => Void;

    //! @brief Function that will always panic.
    export let panics = fn (message: String) => panic message;

    //! @brief Baseline function to return values.
    export let encapsulate = fn (value) => value;
};

// - TEST CASES - //

Test.suite("Traits", fn {
    // prepare a value to be passed
    let value = 42;

    // attempt calling the future now
    let future = Mock.encapsulate::async(value);

    // ensure we have an incoming future
    Test.case("Call 'encapsulate'", fn => Assert.okay(future is Future[Any]));
    Test.case("Await 'encapsulate'", fn => Assert.equals(future.await(), value));
});

Test.suite("Methods", fn {
    // prepare a value to be passed
    let message = "Custom Message!";

    // prepare the futures to be used now
    let failure = Mock.panics::async(message);
    let success = Mock.encapsulate::async(message);

    // prepare a transformation to be applied
    let transform = fn (value: Any): String {
        if (value is Exception) return Detail.Unsafe.cast[Exception](value).message().to_upper();
        return String.from(value).to_upper(); // attempt getting a suitable value to be resolved
    };

    // test the expected await results now
    Test.case("Future.await 'success'", fn => Assert.equals(success.await(), message));
    Test.case("Future.await 'failure'", fn => Assert.panics(Function.bind(failure.await, failure)));

    // test the expected state values now
    Test.case("Future.state 'REJECTED'", fn => Assert.equals(failure.state(), 1));
    Test.case("Future.state 'RESOLVED'", fn => Assert.equals(success.state(), 2));

    // test that we can transform valid values
    Test.case("Future.then 'success'", fn {
        let future = success.then(transform); // bind
        Assert.equals(future.await(), transform(message));
    });

    // test that we can transform invalid values
    Test.case("Future.fails 'failure'", fn {
        let future = failure.fails(transform); // bind
        Assert.equals(future.await(), transform(message));
    });
});

Test.suite("Statics", fn {
    // test the baseline future value now
    Test.case("Future.async 'Function'", fn {
        let future = Future.async(Mock.noop);
        Assert.okay(future is Future[Void]);
        Assert.equals(future.await(), Void);
    });

    // test the resolution constructor
    Test.case("Future.resolve 'Void'", fn {
        let future = Future.resolve(Void);
        Assert.okay(future is Future[Void]);
        Assert.equals(future.state(), 2);
        Assert.equals(future.await(), Void);
    });

    // test the rejection constructor
    Test.case("Future.reject '()'", fn {
        let message = "Rejected Future Message";
        mut future = Future.reject(message);
        Assert.okay(future is Future[Any]);
        Assert.equals(future.state(), 1);

        // pull out the incoming details of the exception to check that we received it
        Assert.equals(future.fails(fn (error) => error).await(), message);
    });
});
