// /
// / @testing Builtin "Result" Functionality.
// / @describe Coordinates testing the builtin "Result".
// /

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST MOCKS - //

namespace Mock {
    //! @brief Prepare a consistent value.
    export let value: Any = 42;

    //! @brief Prepare a consistent error.
    export let error: Any = Void;

    //! @brief Prepare a success result value.
    export let success = Result.okay(value);

    //! @brief Prepare a failure result value.
    export let failure = Result.error(error);
};

// - TEST CASES - //

Test.suite("Methods", fn {
    Test.case("Result.is_okay", fn {
        Assert.truthy(Mock.success.is_okay());
        Assert.falsey(Mock.failure.is_okay());
    });

    Test.case("Result.is_error", fn {
        Assert.falsey(Mock.success.is_error());
        Assert.truthy(Mock.failure.is_error());
    });

    Test.case("Result.unwrap_okay", fn {
        Assert.equals(Mock.success.unwrap_okay(), Mock.value);
        Assert.panics(fn => Mock.failure.unwrap_okay());
    });

    Test.case("Result.unwrap_error", fn {
        Assert.panics(fn => Mock.success.unwrap_error());
        Assert.equals(Mock.failure.unwrap_error(), Mock.error);
    });
});

Test.suite("Statics", fn {
    Test.case("Result.okay 'Any'", fn {
        let result = Result.okay(Mock.value);
        Assert.truthy(result.is_okay());
        Assert.panics(fn => result.unwrap_error());
        Assert.equals(result.unwrap_okay(), Mock.value);
    });

    Test.case("Result.error 'Any'", fn {
        let result = Result.error(Mock.error);
        Assert.truthy(result.is_error());
        Assert.panics(fn => result.unwrap_okay());
        Assert.equals(result.unwrap_error(), Mock.error);
    });

    Test.case("Result.wrap 'Future'", fn {
        // prepare some futures to wrap
        let noop = (fn => Mock.value)::async();
        let panics = (fn => panic)::async();

        // wrap the incoming futures
        let success = Result.wrap(noop);
        let failure = Result.wrap(panics);

        // and test them against expected results
        Assert.truthy(success.is_okay());
        Assert.truthy(failure.is_error());

        // check the resulting values as well
        Assert.equals(success.unwrap_okay(), Mock.value);
        Assert.truthy(failure.unwrap_error() is Exception);
    });
});
