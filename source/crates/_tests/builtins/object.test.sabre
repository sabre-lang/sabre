///
/// @testing Builtin "Object" Functionality.
/// @describe Coordinates testing the builtin "Object".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST CASES - //

Test.suite("Traits", fn {
    // prepare a consistent object value
    let empty: Object = {};

    // test for incoming equality now
    Test.case("Equality '=='", fn => Assert.equals(empty, empty));
    Test.case("Equality '!='", fn => Assert.differs(empty, {}));
});
