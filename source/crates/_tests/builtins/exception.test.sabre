///
/// @testing Builtin "Exception" Functionality.
/// @describe Coordinates testing the builtin "Exception".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST MOCKS - //

namespace Mock {
    //! @brief Prepare the defaulted exception value.
    export let default = Exception.from();

    //! @brief Prepare an exception with a custom message.
    export let custom = Exception.from("...");

    //! @brief Prepare an exception with a custom name.
    export let named = Exception.named("Custom");
};

// - TEST CASES - //

Test.suite("Methods", fn {
    Test.case("Exception.name '()'", fn {
        Assert.equals(Mock.default.name(), "Runtime");
        Assert.equals(Mock.custom.name(), "Runtime");
        Assert.equals(Mock.named.name(), "Custom");
    });

    Test.case("Exception.message '()'", fn {
        Assert.equals(Mock.default.message(), "");
        Assert.equals(Mock.custom.message(), "...");
        Assert.equals(Mock.named.message(), "");
    });
});

Test.suite("Statics", fn {
    Test.case("Exception.from '()'", fn {
        let exception = Exception.from();
        Assert.equals(Mock.default.name(), exception.name());
        Assert.equals(Mock.default.message(), exception.message());
    });

    Test.case("Exception.named 'String'", fn {
        let exception = Exception.named("Custom");
        Assert.equals(Mock.named.name(), exception.name());
        Assert.equals(Mock.named.message(), exception.message());
    });
});
