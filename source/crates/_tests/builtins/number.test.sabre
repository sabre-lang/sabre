///
/// @testing Builtin "Number" Functionality.
/// @describe Coordinates testing the builtin "Number".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST CASES - //

Test.suite("Traits", fn {
    Test.case("Operator '+'", fn => Assert.equals(1 + 2, 3));
    Test.case("Operator '-'", fn => Assert.equals(1 - 0.5, 0.5));
    Test.case("Operator '/'", fn => Assert.equals(1 / 2, 0.5));
    Test.case("Operator '*'", fn => Assert.equals(1 * 2, 2));
    Test.case("Operator '%'", fn => Assert.equals(5 % 2, 1));
    Test.case("Operator '**'", fn => Assert.equals(1.25 ** 2, 1.5625));

    Test.case("Operator '^'", fn => Assert.equals(1 ^ 2, 3));
    Test.case("Operator '<<'", fn => Assert.equals(1 << 8, 256));
    Test.case("Operator '>>'", fn => Assert.equals(-123 >> 3, -16));

    Test.case("Operator '|'", fn => Assert.equals(1 | 2, 3));
    Test.case("Operator '&'", fn => Assert.equals(1 & 2, 0));

    Test.case("Equality '=='", fn => Assert.equals(123.456, 123.456));
    Test.case("Equality '!='", fn => Assert.differs(0.1 + 0.2, 0.3));
});

Test.suite("Methods", fn {
    Test.case("Number.sign '()'", fn {
        Assert.equals((-1.2).sign(), -1);
        Assert.equals((10.6).sign(), 1);
    });

    Test.case("Number.abs '()'", fn {
        Assert.equals((10.2).abs(), 10.2);
        Assert.equals((-10.2).abs(), 10.2);
    });

    Test.case("Number.ceil '()'", fn => Assert.equals((10.5).ceil(), 11));
    Test.case("Number.floor '()'", fn => Assert.equals((10.5).floor(), 10));
    Test.case("Number.round '()'", fn => Assert.equals((10.2).round(), 10));
    Test.case("Number.trunc '()'", fn {
        Assert.equals((10.2).trunc(), 10);
        Assert.equals((10.8).trunc(), 10);
        Assert.equals((-0.123).trunc(), -0);
        Assert.equals((-13.37).trunc(), -13);
    });

    Test.case("Number.clamp '...Number'", fn {
        Assert.equals((10).clamp(), 10);
        Assert.equals((10).clamp(5, 10), 10);
        Assert.equals((10).clamp(5, 8), 8);
        Assert.equals((10).clamp(12, 20), 12);
    });

    Test.case("Number.is_nan '()'", fn {
        Assert.truthy(NaN.is_nan());
        Assert.falsey((42).is_nan());
        Assert.falsey(Infinity.is_nan());
    });

    Test.case("Number.is_fin '()'", fn {
        Assert.falsey(NaN.is_fin());
        Assert.truthy((42).is_fin());
        Assert.falsey(Infinity.is_fin());
    });

    Test.case("Number.is_inf '()'", fn {
        Assert.falsey(NaN.is_inf());
        Assert.falsey((42).is_inf());
        Assert.truthy(Infinity.is_inf());
    });

    Test.case("Number.to_precision 'Number?'", fn {
        let value = 10.125; // basic value to use
        Assert.equals(value.to_precision(), "10.125");
        Assert.equals(value.to_precision(0), "10");
        Assert.equals(value.to_precision(5), "10.12500");
    });

    Test.case("Number.to_scientific 'Number?'", fn {
        let value = 123456.789; // basic value to use
        Assert.equals(value.to_scientific(), "1.234568e+05");
        Assert.equals(value.to_scientific(0), "1e+05");
        Assert.equals(value.to_scientific(2), "1.2e+05");
        Assert.equals(value.to_scientific(4), "1.235e+05");
    });
});

Test.suite("Statics", fn {
    Test.case("Number.parse 'String'", fn {
        Assert.equals(Number.parse("10.2"), 10.2);
        Assert.equals(Number.parse("1.2e1"), 12);
        Assert.equals(Number.parse("1.2E1"), 12);
        Assert.equals(Number.parse(".5"), 0.5);
        Assert.equals(Number.parse("inf"), Infinity);
        Assert.equals(Number.parse("Inf"), Infinity);
        Assert.equals(Number.parse("-inf"), -Infinity);
        Assert.equals(Number.parse("-Inf"), -Infinity);

        Assert.truthy(Number.parse("nan").is_nan());
        Assert.truthy(Number.parse("NaN").is_nan());
        Assert.truthy(Number.parse("NAN").is_nan());
    });
});
