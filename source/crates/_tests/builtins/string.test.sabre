///
/// @testing Builtin "String" Functionality.
/// @describe Coordinates testing the builtin "String".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST MOCKS - //

namespace Mock {
    //! @brief Prepare an empty value.
    export let none = "";

    //! @brief Prepare an ASCII value.
    export let ascii = "abcdef";

    //! @brief Prepare a Unicode value.
    export let unicode = "maçã";

    //! @brief Prepare some emoji value.
    export let emoji = "🦄";

    //! @brief Prepare a larger phrase.
    export let phrase = "Hello, World!";
};

// - TEST CASES - //

Test.suite("Traits", fn {
    Test.case("Operator '+'", fn => Assert.equals("foo" + "bar", "foobar"));

    Test.case("Equality '=='", fn => Assert.equals("abc", "abc"));
    Test.case("Equality '!='", fn => Assert.differs("foo", "bar"));
});

Test.suite("Methods", fn {
    Test.case("String.size '()'", fn {
        Assert.equals(Mock.none.size(), 0);
        Assert.equals(Mock.ascii.size(), 6);
        Assert.equals(Mock.unicode.size(), 4);
        Assert.equals(Mock.emoji.size(), 1);
    });

    Test.case("String.empty '()'", fn {
        Assert.truthy(Mock.none.empty());
        Assert.falsey(Mock.ascii.empty());
        Assert.falsey(Mock.unicode.empty());
        Assert.falsey(Mock.emoji.empty());
    });

    Test.case("String.bytes '()'", fn {
        Assert.equals(Mock.none.bytes(), 0);
        Assert.equals(Mock.ascii.bytes(), 6);
        Assert.equals(Mock.unicode.bytes(), 6);
        Assert.equals(Mock.emoji.bytes(), 4);
    });

    Test.case("String.symbol '()'", fn {
        Assert.equals(Mock.none.symbol(), Symbol.from(Mock.none));
        Assert.equals(Mock.ascii.symbol(), Symbol.from(Mock.ascii));
        Assert.equals(Mock.unicode.symbol(), Symbol.from(Mock.unicode));
        Assert.equals(Mock.emoji.symbol(), Symbol.from(Mock.emoji));
    });

    Test.case("String.at 'Number'", fn {
        Assert.panics(fn => Mock.none.at(0));
        Assert.equals(Mock.emoji.at(0), Mock.emoji);
    });

    Test.case("String.slice 'Number?, Number?'", fn {
        Assert.equals(Mock.none.slice(), Mock.none);
        Assert.equals(Mock.phrase.slice(), Mock.phrase);
        Assert.equals(Mock.phrase.slice(0), Mock.phrase);
    });

    Test.case("String.compare 'String'", fn {
        Assert.equals("".compare(""), 0);
        Assert.truthy("".compare("a") < 0);
        Assert.truthy("a".compare("") > 0);
        Assert.equals("a".compare("a"), 0);
        Assert.truthy("a".compare("b") < 0);
        Assert.truthy("c".compare("b") > 0);
        Assert.truthy("aaa".compare("bbb") < 0);
        Assert.truthy("aaa".compare("bb") < 0);
        Assert.truthy("aa".compare("aab") < 0);
        Assert.truthy("aab".compare("aa") > 0);
        Assert.truthy("zzz".compare("a") > 0);
    });

    Test.case("String.contains 'String'", fn {
        Assert.truthy("".contains(""));
        Assert.truthy("foo".contains(""));
        Assert.truthy("foo".contains("foo"));
        Assert.truthy("foo".contains("o"));
        Assert.truthy("😆".contains("😆"));
        Assert.truthy("😆foo".contains("foo"));

        Assert.falsey("".contains("x"));
        Assert.falsey("foo".contains("x"));
        Assert.falsey("foo".contains("😆"));
    });

    Test.case("String.starts_with '()'", fn {
        Assert.truthy("".starts_with(""));
        Assert.truthy("hello".starts_with(""));
        Assert.truthy("hello".starts_with("hello"));
        Assert.truthy("😆foo".starts_with("😆"));
        Assert.truthy("foo😆".starts_with("foo"));

        Assert.falsey("".starts_with("x"));
        Assert.falsey("hello".starts_with("x"));
        Assert.falsey("😆foo".starts_with("foo"));
    });

    Test.case("String.ends_with '()'", fn {
        Assert.truthy("".ends_with(""));
        Assert.truthy("hello".ends_with(""));
        Assert.truthy("hello".ends_with("hello"));
        Assert.truthy("foo😆".ends_with("😆"));
        Assert.truthy("😆foo".ends_with("foo"));

        Assert.falsey("".ends_with("x"));
        Assert.falsey("hello".ends_with("x"));
        Assert.falsey("foo😆".ends_with("foo"));
    });

    Test.case("String.to_lower '()'", fn {
        Assert.equals("Ä".to_lower(), "ä");
        Assert.equals("AÄ".to_lower(), "aä");
        Assert.equals("HELLO".to_lower(), "hello");
    });

    Test.case("String.to_upper '()'", fn {
        Assert.equals("ä".to_upper(), "Ä");
        Assert.equals("aä".to_upper(), "AÄ");
        Assert.equals("hello".to_upper(), "HELLO");
    });

    Test.case("String.trim_both '()'", fn {
        Assert.equals("".trim_both(), "");
        Assert.equals("hello".trim_both(), "hello");
        Assert.equals(" hello ".trim_both(), "hello");
        Assert.equals("  hello  ".trim_both(), "hello");
        Assert.equals("  ".trim_both(), "");

        Assert.equals("\thello\t".trim_both(), "hello");
        Assert.equals("\rhello\r".trim_both(), "hello");
        Assert.equals("\nhello\n".trim_both(), "hello");
        Assert.equals("hello\t\r\n\t".trim_both(), "hello");
    });

    Test.case("String.trim_leading '()'", fn {
        Assert.equals("".trim_leading(), "");
        Assert.equals("hello".trim_leading(), "hello");
        Assert.equals(" hello ".trim_leading(), "hello ");
        Assert.equals("  hello  ".trim_leading(), "hello  ");
        Assert.equals("  ".trim_leading(), "");

        Assert.equals("\thello\t".trim_leading(), "hello\t");
        Assert.equals("\rhello\r".trim_leading(), "hello\r");
        Assert.equals("\nhello\n".trim_leading(), "hello\n");
        Assert.equals("\t\r\n\thello".trim_leading(), "hello");
    });

    Test.case("String.trim_trailing '()'", fn {
        Assert.equals("".trim_trailing(), "");
        Assert.equals("hello".trim_trailing(), "hello");
        Assert.equals(" hello ".trim_trailing(), " hello");
        Assert.equals("  hello  ".trim_trailing(), "  hello");
        Assert.equals("  ".trim_trailing(), "");

        Assert.equals("\thello\t".trim_trailing(), "\thello");
        Assert.equals("\rhello\r".trim_trailing(), "\rhello");
        Assert.equals("\nhello\n".trim_trailing(), "\nhello");
        Assert.equals("hello\t\r\n\t".trim_trailing(), "hello");
    });

    Test.case("String.pad_leading 'Number, String?'", fn {
        Assert.equals("foo".pad_leading(0), "foo");
        Assert.equals("foo".pad_leading(3, ""), "foo");
        Assert.equals("foo".pad_leading(3, " "), "foo");
        Assert.equals("foo".pad_leading(4, " "), " foo");
        Assert.equals("foo".pad_leading(4, "a"), "afoo");
        Assert.equals("foo".pad_leading(4, "ab"), "afoo");
        Assert.equals("foo".pad_leading(5, "ab"), "abfoo");
        Assert.equals("foo".pad_leading(6, "ab"), "abafoo");
        Assert.equals("foo".pad_leading(7, "ab"), "ababfoo");
    });

    Test.case("String.pad_trailing 'Number, String?'", fn {
        Assert.equals("foo".pad_trailing(0), "foo");
        Assert.equals("foo".pad_trailing(3, ""), "foo");
        Assert.equals("foo".pad_trailing(3, " "), "foo");
        Assert.equals("foo".pad_trailing(4, " "), "foo ");
        Assert.equals("foo".pad_trailing(4, "a"), "fooa");
        Assert.equals("foo".pad_trailing(4, "ab"), "fooa");
        Assert.equals("foo".pad_trailing(5, "ab"), "fooab");
        Assert.equals("foo".pad_trailing(6, "ab"), "fooaba");
        Assert.equals("foo".pad_trailing(7, "ab"), "fooabab");
    });

    Test.case("String.fmt '...Any'", fn {
        Assert.equals("".fmt(), "");
        Assert.equals("".fmt(""), "");
        Assert.equals("{0}".fmt(Void), "Void");
        Assert.equals("{0}".fmt(42), "42");
    });
});

Test.suite("Statics", fn {
    Test.case("String.from 'Any'", fn {
        Assert.equals(String.from(42), "42");
        Assert.equals(String.from(True), "True");
        Assert.equals(String.from(False), "False");
        Assert.equals(String.from(Void), "Void");
    });

    Test.case("String.codepoint 'Number'", fn {
        Assert.equals(String.codepoint(129412), Mock.emoji);
    });
});
