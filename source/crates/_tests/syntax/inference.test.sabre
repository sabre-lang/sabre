///
/// @testing Syntax "is" Expression.
/// @describe Coordinates testing the inference expression "is".
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST CASES - //

Test.suite("Syntax", fn {
    Test.case("'Void' is Void", fn => Assert.okay(Void is Void));

    Test.case("'True' is Boolean", fn => Assert.okay(True is Boolean));
    Test.case("'False' is Boolean", fn => Assert.okay(False is Boolean));

    Test.case("Literal is List", fn => Assert.okay([] is List[Any]));
    Test.case("Literal is Number", fn => Assert.okay(42 is Number));
    Test.case("Literal is Object", fn => Assert.okay({} is Object));
    Test.case("Literal is String", fn => Assert.okay("" is String));
});
