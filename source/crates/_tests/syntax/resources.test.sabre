///
/// @testing Syntax "use" Declaration.
/// @describe Coordinates testing the builtin "use" declaration.
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST MOCKS - //

namespace Mock {
    //! @brief Prepare a disposable handler.
    export let attempt = fn (factory: Function) {
        // prepare a mutable result value
        let expect: Any = 42;
        let initial: Any = Void;
        mut result: Any = initial;

        // prepare a callback for modifying the value
        let dispose = fn => result = expect;

        // check the current value to ensure not expected
        Assert.equals(result, initial);
        Assert.differs(initial, expect);

        // attempt scoping our resource now
        {
            use scoped = factory(dispose);
            Assert.equals(result, initial);
        }

        // finally check that our scoped value changed
        Assert.equals(result, expect);
    };

    //! @brief Binds a scoped callback.
    export let scope = fn (target: Function): Any {
        // An anonymous resource (see below note).
        let resource = {};

        // Attaching a disposal callback to the resource directly.
        #[Operator.dispose resource]
        let callback = fn => target();

        // Return the constructed resource.
        return resource;
    };

    //! @brief Binds a disposable class.
    export class temporary(target: Function) {
        #[Operator.dispose]
        private let m_dispose = fn => target();
    };
};

// - TEST CASES - //

Test.suite("Syntax", fn {
    Test.case("Dispose 'scoped'", fn {
        Mock.attempt(Mock.scope);
    });

    Test.case("Dispose 'class'", fn {
        Mock.attempt(Mock.temporary);
    });
});
