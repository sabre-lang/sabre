///
/// @testing Syntax "@..." Declaration.
/// @describe Coordinates testing builtin decorator syntax.
///

// Sabre Modules
import "sabre:test" as Test;
import "sabre:assert" as Assert;

// - TEST MOCKS - //

namespace Mock {
    //! @brief Uppercase Decorator Typing
    export type Upper = fn (...Any) -> String;

    //! @brief ...
    export let Upper = fn =>
        fn (target: Upper): Upper {
            return fn (...args: Any): String {
                let result = Function.apply(target, args);
                if (result is String) return result.to_upper();
                panic "Expected a result value of type 'String'";
            };
        };
};

// - TEST CASES - //

Test.suite("Syntax", fn {
    Test.case("@Upper '()'", fn {
        // prepare a baseline message to transform
        let message = "hello world";

        // prepare the bound decorator transform
        @Mock.Upper()
        let target = fn => message;

        // prepare a bad decorator instance
        @Mock.Upper()
        let failure = fn => Void;

        // call the target in question now
        let result = target();

        // and check the resulting outputs
        Assert.panics(fn => failure());
        Assert.equals(result, message.to_upper());
    });
});
