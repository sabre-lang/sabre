///
/// @crate "mem"
/// @describe Utility functions for reading memory usage.
///

// Dynamic Modules
import "dylib:mem" as mem;

// Sabre Modules
import "sabre:_detail" as Detail;

// - HELPERS - //

//! @brief Internal helper to reduce bytecode output.
let m_cast = Detail.Unsafe.cast;

// - NAMESPACES - //

export namespace Heap {
    // - PUBLIC METHODS - //

    //! @brief Gets the total heap memory.
    export let total = m_cast[fn -> Number](mem.heap_total);

    //! @brief Gets the current heap memory usage.
    export let usage = m_cast[fn -> Number](mem.heap_usage);

    //! @brief Gets the current heap memory available.
    export let avail = m_cast[fn -> Number](mem.heap_avail);
};

export namespace Thread {
    // - PUBLIC METHODS - //

    //! @brief Gets the total thread-stack memory.
    export let total = m_cast[fn -> Number](mem.thread_total);

    //! @brief Gets the current thread-stack memory usage.
    export let usage = m_cast[fn -> Number](mem.thread_usage);

    //! @brief Gets the current thread-stack memory available.
    export let avail = m_cast[fn -> Number](mem.thread_avail);
};
