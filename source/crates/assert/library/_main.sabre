///
/// @crate "assert"
/// @describe Assertion functions for verifying invariants.
///

// Dynamic Modules
import "dylib:assert" as assert;

// Sabre Modules
import "sabre:_detail" as Detail;

// - HELPERS - //

//! @brief Internal helper to reduce bytecode output.
let m_cast = Detail.Unsafe.cast;

// - PUBLIC METHODS - //

//! @brief Throws an immediate failure.
//! @param msg                  Optional message.
export let fail = m_cast[fn (msg?: String) -> Never](assert.fail);

//! @brief Asserts that a value is truthy.
//! @param value                Value to assert.
//! @param msg                  Optional message.
export let okay = m_cast[fn (value: Any, msg?: String)](assert.okay);

//! @brief Asserts that a value is truthy.
//! @param value                Value to assert.
//! @param msg                  Optional message.
export let truthy = m_cast[fn (value: Any, msg?: String)](assert.truthy);

//! @brief Asserts that a value is falsey.
//! @param value                Value to assert.
//! @param msg                  Optional message.
export let falsey = m_cast[fn (value: Any, msg?: String)](assert.falsey);

//! @brief Asserts that a value is not `Void`.
//! @param value                Value to assert.
//! @param msg                  Optional message.
export let exists = m_cast[fn (value: Any, msg?: String)](assert.exists);

//! @brief Asserts the equality of two values.
//! @param actual               Value to assert.
//! @param expected             Expected value.
//! @param msg                  Optional message.
export let equals = m_cast[fn (actual: Any, expected: Any, msg?: String)](assert.equals);

//! @brief Asserts the inequality of two values.
//! @param actual               Value to assert.
//! @param unexpected           Unexpected value.
//! @param msg                  Optional message.
export let differs = m_cast[fn (actual: Any, unexpected: Any, msg?: String)](assert.differs);

//! @brief Expects the incoming function to panic.
//! @param callback             Callback to execute.
//! @param msg                  Optional message.
export let panics = m_cast[fn (callback: fn -> Any, msg?: String)](assert.panics);
