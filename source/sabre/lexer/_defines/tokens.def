/// Vendor Includes
#include <xtdlib/xtdlib.hpp>

//  X-MACROS  //

#ifndef SABRE_XX_TOKEN_BASE
#define SABRE_XX_TOKEN_BASE(T, ...)
#endif

#ifndef SABRE_XX_TOKEN_SYMBOL
#define SABRE_XX_TOKEN_SYMBOL(T, S, ...) SABRE_XX_TOKEN_BASE(T, __VA_ARGS__)
#endif

#ifndef SABRE_XX_TOKEN_PUNC
#define SABRE_XX_TOKEN_PUNC(T, S, ...) SABRE_XX_TOKEN_SYMBOL(PUNC_##T, S, __VA_ARGS__)
#endif

#ifndef SABRE_XX_TOKEN_UNARY
#define SABRE_XX_TOKEN_UNARY(T, S, ...) SABRE_XX_TOKEN_SYMBOL(UNOP_##T, S, __VA_ARGS__)
#endif

#ifndef SABRE_XX_TOKEN_BINARY
#define SABRE_XX_TOKEN_BINARY(T, S, P, ...) SABRE_XX_TOKEN_SYMBOL(BINOP_##T, S, __VA_ARGS__)
#endif

#ifndef SABRE_XX_TOKEN_COMPARE
#define SABRE_XX_TOKEN_COMPARE(T, S, P, ...) SABRE_XX_TOKEN_BINARY(T, S, P, __VA_ARGS__)
#endif

#ifndef SABRE_XX_TOKEN_ASSIGN
#define SABRE_XX_TOKEN_ASSIGN(T, S, P, ...)                                     \
  SABRE_XX_TOKEN_BINARY(T, S, P, __VA_ARGS__)                                   \
  SABRE_XX_TOKEN_SYMBOL(ASOP_##T, S "=", Flag::ASSIGNS $_PP_VARGS(__VA_ARGS__))
#endif

#ifndef SABRE_XX_TOKEN_KEYWORD
#define SABRE_XX_TOKEN_KEYWORD(T, K, ...) SABRE_XX_TOKEN_BASE(T, __VA_ARGS__)
#endif

#ifndef SABRE_XX_TOKEN_MODIFIER
#define SABRE_XX_TOKEN_MODIFIER(T, K, ...) SABRE_XX_TOKEN_KEYWORD(MOD_##T, K, Flag::MODIFIER $_PP_VARGS(__VA_ARGS__))
#endif

//  MACROS  //

/// Punctuation Tokens
SABRE_XX_TOKEN_PUNC(QUERY, "?")
SABRE_XX_TOKEN_PUNC(PERIOD, ".")
SABRE_XX_TOKEN_PUNC(SPREAD, "...")
SABRE_XX_TOKEN_PUNC(COLON, ":", Flag::TRAILING)
SABRE_XX_TOKEN_PUNC(POLICY, "::", Flag::TRAILING)
SABRE_XX_TOKEN_PUNC(COMMA, ",", Flag::TRAILING)
SABRE_XX_TOKEN_PUNC(TERM, ";", Flag::TRAILING, Flag::WHITESPACE)

SABRE_XX_TOKEN_PUNC(ATTR, "#", Flag::DECORATES, Flag::SYNCABLE)
SABRE_XX_TOKEN_PUNC(DECOR, "@", Flag::DECORATES, Flag::SYNCABLE)

SABRE_XX_TOKEN_PUNC(LPAREN, "(", Flag::LEADING)
SABRE_XX_TOKEN_PUNC(RPAREN, ")", Flag::TRAILING)
SABRE_XX_TOKEN_PUNC(LBRACE, "{", Flag::LEADING)
SABRE_XX_TOKEN_PUNC(RBRACE, "}", Flag::TRAILING)
SABRE_XX_TOKEN_PUNC(LBRACK, "[", Flag::LEADING)
SABRE_XX_TOKEN_PUNC(RBRACK, "]", Flag::TRAILING)

SABRE_XX_TOKEN_SYMBOL(ARROW_THIN, "->")
SABRE_XX_TOKEN_SYMBOL(ARROW_BOLD, "=>")

/// Operator Tokens
SABRE_XX_TOKEN_UNARY(NOT, "!")
SABRE_XX_TOKEN_UNARY(INC, "++")
SABRE_XX_TOKEN_UNARY(DEC, "--")
SABRE_XX_TOKEN_UNARY(INV, "~")

SABRE_XX_TOKEN_COMPARE(EQ, "==", EQUAL)
SABRE_XX_TOKEN_COMPARE(NE, "!=", EQUAL)
SABRE_XX_TOKEN_COMPARE(LE, "<=", COMPARE)
SABRE_XX_TOKEN_COMPARE(GE, ">=", COMPARE)
SABRE_XX_TOKEN_COMPARE(LT, "<", COMPARE)
SABRE_XX_TOKEN_COMPARE(GT, ">", COMPARE)

SABRE_XX_TOKEN_KEYWORD(BINOP_IN, "in", Flag::RESERVED)
SABRE_XX_TOKEN_KEYWORD(BINOP_IS, "is", Flag::RESERVED)
SABRE_XX_TOKEN_KEYWORD(BINOP_AS, "as", Flag::RESERVED)

SABRE_XX_TOKEN_SYMBOL(ASOP_DEF, "=", Flag::ASSIGNS)

SABRE_XX_TOKEN_ASSIGN(ADD, "+", TERM)
SABRE_XX_TOKEN_ASSIGN(SUB, "-", TERM)
SABRE_XX_TOKEN_ASSIGN(MUL, "*", FACTOR)
SABRE_XX_TOKEN_ASSIGN(DIV, "/", FACTOR)
SABRE_XX_TOKEN_ASSIGN(MOD, "%", FACTOR)
SABRE_XX_TOKEN_ASSIGN(POW, "**", EXPONENT)

SABRE_XX_TOKEN_ASSIGN(XOR, "^", XOR)
SABRE_XX_TOKEN_ASSIGN(SHL, "<<", SHIFT)
SABRE_XX_TOKEN_ASSIGN(SHR, ">>", SHIFT)

SABRE_XX_TOKEN_ASSIGN(BOR, "|", BOR)
SABRE_XX_TOKEN_ASSIGN(LOR, "||", LOR)
SABRE_XX_TOKEN_ASSIGN(BAND, "&", BAND)
SABRE_XX_TOKEN_ASSIGN(LAND, "&&", LAND)

SABRE_XX_TOKEN_BINARY(COAL, "??", COAL)

/// Literal Tokens
SABRE_XX_TOKEN_BASE(LTRL_BIN, Flag::NUMERIC)
SABRE_XX_TOKEN_BASE(LTRL_OCT, Flag::NUMERIC)
SABRE_XX_TOKEN_BASE(LTRL_HEX, Flag::NUMERIC)
SABRE_XX_TOKEN_BASE(LTRL_INT, Flag::NUMERIC)
SABRE_XX_TOKEN_BASE(LTRL_FLT, Flag::NUMERIC)

SABRE_XX_TOKEN_BASE(LTRL_STR, Flag::STRING)
SABRE_XX_TOKEN_BASE(LTRL_IDENT, Flag::ANNOTATES)

SABRE_XX_TOKEN_KEYWORD(LTRL_SELF, "Self", Flag::RESERVED)
SABRE_XX_TOKEN_KEYWORD(LTRL_VOID, "Void", Flag::VOID, Flag::ANNOTATES)
SABRE_XX_TOKEN_KEYWORD(LTRL_TRUE, "True", Flag::BOOLEAN, Flag::ANNOTATES)
SABRE_XX_TOKEN_KEYWORD(LTRL_FALSE, "False", Flag::BOOLEAN, Flag::ANNOTATES)
SABRE_XX_TOKEN_KEYWORD(LTRL_NAN, "NaN", Flag::NUMERIC, Flag::ANNOTATES)
SABRE_XX_TOKEN_KEYWORD(LTRL_INF, "Infinity", Flag::NUMERIC, Flag::ANNOTATES)

/// Keyword Tokens
SABRE_XX_TOKEN_KEYWORD(DECL_LET, "let", Flag::DEFINES, Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(DECL_MUT, "mut", Flag::DEFINES, Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(DECL_USE, "use", Flag::DEFINES, Flag::RESERVED, Flag::SYNCABLE)

SABRE_XX_TOKEN_KEYWORD(DECL_FUNC, "fn", Flag::RESERVED)
SABRE_XX_TOKEN_KEYWORD(DECL_ENUM, "enum", Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(DECL_TYPE, "type", Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(DECL_SPACE, "namespace", Flag::RESERVED, Flag::SYNCABLE)

SABRE_XX_TOKEN_KEYWORD(DECL_IMPL, "implements", Flag::ANNOTATES)
SABRE_XX_TOKEN_KEYWORD(DECL_CLASS, "class", Flag::RESERVED, Flag::SYNCABLE)

SABRE_XX_TOKEN_KEYWORD(MOD_IMPORT, "import", Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(MOD_EXPORT, "export", Flag::RESERVED, Flag::SYNCABLE, Flag::MODIFIER)

SABRE_XX_TOKEN_MODIFIER(PUBLIC, "public", Flag::RESERVED, Flag::SYNCABLE, Flag::ACCESSOR)
SABRE_XX_TOKEN_MODIFIER(PRIVATE, "private", Flag::RESERVED, Flag::SYNCABLE, Flag::ACCESSOR)
SABRE_XX_TOKEN_MODIFIER(PROTECTED, "protected", Flag::RESERVED, Flag::SYNCABLE, Flag::ACCESSOR)

SABRE_XX_TOKEN_KEYWORD(FLOW_ELSE, "else", Flag::RESERVED)
SABRE_XX_TOKEN_KEYWORD(FLOW_IF, "if", Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(FLOW_MATCH, "match", Flag::RESERVED, Flag::SYNCABLE)

SABRE_XX_TOKEN_KEYWORD(FLOW_BREAK, "break", Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(FLOW_CONT, "continue", Flag::RESERVED, Flag::SYNCABLE)

SABRE_XX_TOKEN_KEYWORD(FLOW_PANIC, "panic", Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(FLOW_RETURN, "return", Flag::RESERVED, Flag::SYNCABLE)

SABRE_XX_TOKEN_KEYWORD(LOOP_FOR, "for", Flag::RESERVED, Flag::SYNCABLE)
SABRE_XX_TOKEN_KEYWORD(LOOP_ANY, "loop", Flag::RESERVED, Flag::SYNCABLE)

/// Core Token Values
SABRE_XX_TOKEN_BASE(MISC_CMT, Flag::WHITESPACE)

/// Sentinel Token Values
SABRE_XX_TOKEN_BASE(MISC_MAX)

//  UNDEFINES  //

#undef SABRE_XX_TOKEN_BASE
#undef SABRE_XX_TOKEN_SYMBOL
#undef SABRE_XX_TOKEN_PUNC
#undef SABRE_XX_TOKEN_UNARY
#undef SABRE_XX_TOKEN_BINARY
#undef SABRE_XX_TOKEN_COMPARE
#undef SABRE_XX_TOKEN_ASSIGN
#undef SABRE_XX_TOKEN_KEYWORD
#undef SABRE_XX_TOKEN_MODIFIER
