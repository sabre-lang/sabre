//  X-MACROS  //

#ifndef SABRE_XX_DIAGNOSTIC_CODE
#define SABRE_XX_DIAGNOSTIC_CODE(C, N, S, M, ...)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_SYNTAX
#define SABRE_XX_DIAGNOSTIC_SYNTAX(...) SABRE_XX_DIAGNOSTIC_CODE("Syntax", __VA_ARGS__)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_LEXER
#define SABRE_XX_DIAGNOSTIC_LEXER(...) SABRE_XX_DIAGNOSTIC_SYNTAX(__VA_ARGS__)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_ANALYSIS
#define SABRE_XX_DIAGNOSTIC_ANALYSIS(...) SABRE_XX_DIAGNOSTIC_CODE("Analysis", __VA_ARGS__)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_REFERENCE
#define SABRE_XX_DIAGNOSTIC_REFERENCE(...) SABRE_XX_DIAGNOSTIC_CODE("Reference", __VA_ARGS__)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_RUNTIME
#define SABRE_XX_DIAGNOSTIC_RUNTIME(...) SABRE_XX_DIAGNOSTIC_CODE("Runtime", __VA_ARGS__)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_ASSERTION
#define SABRE_XX_DIAGNOSTIC_ASSERTION(...) SABRE_XX_DIAGNOSTIC_CODE("Assertion", __VA_ARGS__)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_IMPORT
#define SABRE_XX_DIAGNOSTIC_IMPORT(...) SABRE_XX_DIAGNOSTIC_CODE("Import", __VA_ARGS__)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_INTERNAL
#define SABRE_XX_DIAGNOSTIC_INTERNAL(...) SABRE_XX_DIAGNOSTIC_CODE("Developer", __VA_ARGS__)
#endif

#ifndef SABRE_XX_DIAGNOSTIC_LINTER
#define SABRE_XX_DIAGNOSTIC_LINTER(S, ...)                                                                       \
  SABRE_XX_DIAGNOSTIC_CODE("Linter", 10000000 | (1 << static_cast<uint8_t>(Severity::S)), S, "{0}")              \
  SABRE_XX_DIAGNOSTIC_CODE("Linter", 10000032 | (1 << static_cast<uint8_t>(Severity::S)), S, "{0}", Deprecated)  \
  SABRE_XX_DIAGNOSTIC_CODE("Linter", 10000064 | (1 << static_cast<uint8_t>(Severity::S)), S, "{0}", Unnecessary)
#endif

