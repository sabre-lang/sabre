SABRE_XX_FIELDS_TYPEDEF("fn -> Boolean")
SABRE_XX_FIELDS_DESCRIBE("Determines if a `Result` contains a value.")
SABRE_XX_FIELDS_FOOTER()

SABRE_XX_FIELDS_HEADER()
SABRE_XX_FIELDS_DEFINE(is_error)
SABRE_XX_FIELDS_TYPEDEF("fn -> Boolean")
SABRE_XX_FIELDS_DESCRIBE("Determines if a `Result` contains an error.")
SABRE_XX_FIELDS_FOOTER()

SABRE_XX_FIELDS_HEADER()
