{
    "version": "0.2.0",
    "configurations": [
        {
            "request": "launch",
            "type": "extensionHost",
            "name": "Sabre: VSC Extension",
            "outFiles": ["${workspaceFolder}/dist/vscode/**/*.js"],
            "args": ["${workspaceFolder}/examples", "--extensionDevelopmentPath=${workspaceFolder}/dist/vscode"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Sabre: Test Natives",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/build/source/tests/tests",
            "windows": {
                "program": "${workspaceFolder}/build/source/tests/tests.exe"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Sabre: Test Builtins",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dist/bin/sabre",
            "args": ["test"],
            "windows": { "program": "${workspaceFolder}/dist/bin/sabre.exe" }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Sabre: Task 'build'",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dist/bin/sabre",
            "args": ["task", "build"],
            "windows": { "program": "${workspaceFolder}/dist/bin/sabre.exe" }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Sabre: Lint Sandbox",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dist/bin/sabre",
            "args": ["lint", "${workspaceFolder}"],
            "windows": { "program": "${workspaceFolder}/dist/bin/sabre.exe" }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Sabre: Format Sandbox",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dist/bin/sabre",
            "args": ["format", "${workspaceFolder}/examples/sandbox.sabre"],
            "windows": { "program": "${workspaceFolder}/dist/bin/sabre.exe" }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Sabre: Bundle Sandbox",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dist/bin/sabre",
            "args": ["bundle", "${workspaceFolder}/examples/sandbox.sabre"],
            "windows": { "program": "${workspaceFolder}/dist/bin/sabre.exe" }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Sabre: Launch Sandbox",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dist/bin/sabre",
            "args": ["run", "${workspaceFolder}/examples/sandbox.sabre"],
            "windows": { "program": "${workspaceFolder}/dist/bin/sabre.exe" }
        }
    ]
}
