{
    "$schema": "vscode://schemas/vscode-extensions",

    "name": "sabre-lang",
    "publisher": "sabre",
    "icon": "icons/sabre.png",
    "author": "Reuben Roessler",
    "displayName": "Sabre Programming Language",
    "repository": "https://github.com/sabre-lang/sabre",
    "description": "Support for the Sabre programming language",

    "activationEvents": [],
    "engines": { "vscode": "^1.22.0" },
    "categories": ["Programming Languages"],

    "contributes": {
        "commands": [
            { "category": "Sabre", "command": "sabre.restart", "title": "Restart Language Server" },
            { "category": "Sabre", "command": "sabre.settings", "title": "Open Extension Settings" }
        ],

        "configurationDefaults": { "[sabre]": { "editor.formatOnSave": true } },
        "configuration": {
            "title": "Sabre",
            "properties": {
                "sabre.server.executablePath": {
                    "default": "",
                    "type": "string",
                    "scope": "machine",
                    "description": "A path to the Sabre executable."
                },
                "sabre.server.loggingLevel": {
                    "default": "warn",
                    "type": "string",
                    "scope": "machine",
                    "enum": ["trace", "debug", "warn", "error", "fatal"],
                    "description": "The logging level for the underlying language server."
                }
            }
        },

        "languages": [
            {
                "id": "sabre",
                "extensions": [".sabre"],
                "aliases": ["Sabre", "sabre"],
                "configuration": "./language-configuration.json",
                "icon": { "light": "icons/sabre.svg", "dark": "icons/sabre.svg" }
            }
        ],

        "grammars": [
            {
                "language": "sabre",
                "scopeName": "source.sabre",
                "path": "./syntaxes/sabre.tmLanguage.json"
            },
            {
                "injectTo": ["text.html.markdown"],
                "scopeName": "markdown.sabre.codeblock",
                "path": "./syntaxes/sabre.injection.json",
                "embeddedLanguages": { "meta.embedded.block.sabre": "sabre" }
            }
        ],

        "jsonValidation": [{ "fileMatch": "_crate.jsonc", "url": "./schemas/crate.schema.json" }]
    }
}
